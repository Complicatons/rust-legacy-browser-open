{
  "serverId": "__SERVER_ID__",
  "centralUrl": "https://your-domain.example/",
  "credentialFile": "__ROOT__/secrets/gateway.credential",
  "controlKeyFile": "__ROOT__/secrets/control.key",
  "metricsTokenFile": "__ROOT__/secrets/metrics.token",
  "sidecarUrl": "http://127.0.0.1:28090",
  "native": {"host": "127.0.0.1", "port": 29015},
  "allowedOrigins": ["https://your-domain.example"],
  "listen": {"host": "__PUBLIC_IP__", "port": 443},
  "path": "/play",
  "tls": {"pfx": "__ROOT__/secrets/gateway-tls.pfx", "passphraseFile": "__ROOT__/secrets/gateway-tls.pass"},
  "trustedProxies": ["cloudflare"],
  "capacity": 100,
  "wipe": "eu1",
  "ngcRegistry": "__REPO__/browser/assets/recovered/ngc/registry.json",
  "recoveredDir": "__REPO__/browser/assets/recovered",
  "anticheat": {"policy": {"autoKick": false}}
}
